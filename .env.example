# Required for server-side AI routes when a client key is not supplied
OPENAI_API_KEY=your_openai_api_key

# Optional analytics and site verification
GA_ID=
MS_CLARITY_ID=
GOOGLE_VERIFICATION_TOKEN=
MS_VERIFICATION_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_DISABLED=false

# Used by sitemap generation; Vercel sets NEXT_PUBLIC_VERCEL_ENV automatically
SITE_URL=https://kanadojo.com
